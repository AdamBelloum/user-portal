# Copy this file to secrets.yml on the Ansible control host.
# Never commit secrets.yml or reuse the previous credential values.
# Generate new, independent values before the first Keycloak deployment.
keycloak_postgres_password: "REPLACE_WITH_A_NEW_POSTGRES_PASSWORD"
keycloak_bootstrap_admin_password: "REPLACE_WITH_A_NEW_KEYCLOAK_ADMIN_PASSWORD"
