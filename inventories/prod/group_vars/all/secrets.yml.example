# Local deployment credentials template.
#
# Copy this file to secrets.yml, replace the placeholders with strong,
# deployment-specific passwords, and protect the resulting local file:
#
#   cp secrets.yml.example secrets.yml
#   chmod 600 secrets.yml
#
# Never commit secrets.yml.

keycloak_bootstrap_admin_password: "CHANGE_ME_WITH_A_STRONG_KEYCLOAK_ADMIN_PASSWORD"
keycloak_postgres_password: "CHANGE_ME_WITH_A_STRONG_KEYCLOAK_POSTGRES_PASSWORD"
